# ── Embeddings ────────────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-small-en-v1.5   # or llama-text-embed-v2 / another HF embedding model

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=personalshopper

# Serverless spec — pick the cloud/region where your Pinecone project lives
# Free tier is available on aws us-east-1
PINECONE_CLOUD=aws
PINECONE_REGION=ap-southeast-1

# ── ElevenLabs TTS (primary; gTTS fallback used if unset) ─────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-key-here
# Optional overrides:
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel (default)
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5   # low-latency (default); use eleven_multilingual_v2 for max quality
